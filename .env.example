GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-flash-latest

# Authentication (set JWT_SECRET in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
ALLOW_ADMIN_SELF_SIGNUP=true

# Docker / deployment
# MINIRISKERS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# MINIRISKERS_DATABASE_URL=sqlite:////app/data/miniriskers.db
# Frontend build (docker): VITE_API_URL=http://localhost:8000

# Optional overrides for development seed user passwords
# DEV_PASSWORD_BUSINESS_OWNER=
# DEV_PASSWORD_RISK_ANALYST=
# DEV_PASSWORD_RISK_COMMITTEE=
# DEV_PASSWORD_AUDITOR=
# DEV_PASSWORD_ADMIN=
